<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PackageId>EmailsDone</PackageId>
    <Version>0.1.3</Version>
    <Authors>EmailsDone</Authors>
    <Company>EmailsDone</Company>
    <Description>Template-first transactional email SDK for EmailsDone.</Description>
    <PackageTags>email;transactional-email;password-reset;verification;notifications;ses;firebase;sdk;dotnet</PackageTags>
    <PackageProjectUrl>https://emailsdone.dev/docs/libraries/dotnet/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/emailsdone-dev/emailsdone-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReleaseNotes>Initial preview release. Template sending and basic recipient and quota details.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>Copyright © EmailsDone</Copyright>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" Link="README.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
    <None Include="..\logo.png" Pack="true" PackagePath="" Link="logo.png" />
  </ItemGroup>
</Project>
